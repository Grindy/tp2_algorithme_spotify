<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="620.0" prefWidth="337.0" style="-fx-border-width: 0 3px 0 0;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.maisonneuve.tp2_algorithme_spotify.controller.PlaylistsController">
    <children>
        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
            <children>
                <Button id="btn-biblio" fx:id="btnVotreBibliotheque" mnemonicParsing="false" styleClass="degrade-vert" text="Votre Bibliothèque">
                    <padding>
                        <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
                    </padding>
                    <HBox.margin>
                        <Insets right="12.0" />
                    </HBox.margin>
                </Button>
                <Button fx:id="btnAjouterPlaylist" mnemonicParsing="false" text="+">
                    <padding>
                        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                    </padding>
                    <styleClass>
                        <String fx:value="btn-ajout-playlist" />
                        <String fx:value="btn-round" />
                    </styleClass>
                    <graphic>
                        <Region id="icone-ajout-playlist" translateX="-2.0" />
                    </graphic>
                </Button>
            </children>
        </HBox>
        <TableView fx:id="tablePlaylists" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colPlaylists" prefWidth="75.0" styleClass="col-playlist" text="Vos Playlists" />
                <TableColumn fx:id="colSupprimerPlaylist" prefWidth="75.0" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
    <opaqueInsets>
        <Insets />
    </opaqueInsets>
    <styleClass>
        <String fx:value="bg-dark-grey" />
        <String fx:value="degrade-vert" />
    </styleClass>
</VBox>